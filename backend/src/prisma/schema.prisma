generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitType {
  INDIVIDUAL
  BOTH
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  paidExpenses Expense[] @relation("PaidBy")
  expenses     Expense[] @relation("Participants")
  budgets      Budget[]
}

model Expense {
  id           Int       @id @default(autoincrement())
  title        String
  amount       Float
  splitType    SplitType
  date         DateTime  @default(now())
  isSettlement Boolean   @default(false)

  paidById Int
  paidBy   User @relation("PaidBy", fields: [paidById], references: [id])

  participants User[] @relation("Participants")
}

model Budget {
  id          Int      @id @default(autoincrement())
  userId      Int
  totalAmount Float
  startDate   DateTime
  endDate     DateTime
  dailyLimit  Float

  user User @relation(fields: [userId], references: [id])
}
